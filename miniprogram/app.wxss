page{background:#f7f6f1;color:#243f33;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:36rpx 32rpx 60rpx}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:#8a927f}.heading{font-size:56rpx;font-weight:700;line-height:1.35;margin:20rpx 0 12rpx}.muted{color:#8b9389;font-size:24rpx}.hero{padding:34rpx;border-radius:28rpx;background:#e8ede3;margin:30rpx 0}.hero-title{font-size:34rpx;font-weight:600}.search{background:#fffefa;border:1rpx solid #e1e5d9;border-radius:18rpx;padding:24rpx 26rpx;margin:26rpx 0}.filters{display:flex;gap:18rpx;margin-bottom:28rpx}.picker{background:#fffefa;border:1rpx solid #e1e5d9;border-radius:14rpx;padding:18rpx 24rpx;font-size:24rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.card{background:#fffefa;border:1rpx solid #e5e6dd;border-radius:22rpx;padding:22rpx;overflow:hidden}.art{height:210rpx;display:flex;align-items:center;justify-content:center;background:#edf0e7;border-radius:14rpx;position:relative}.art image,.art private-image{width:100%;height:100%}.symbol{font-size:70rpx;font-weight:300;color:#768e72}.number{font-size:20rpx;color:#8b9389;letter-spacing:2rpx;margin-top:20rpx}.name{font-size:28rpx;font-weight:600;margin:12rpx 0}.subtitle{font-size:20rpx;color:#8c938a}.chip{font-size:20rpx;display:inline-block;background:#e8eddf;padding:6rpx 14rpx;border-radius:9rpx;margin:12rpx 8rpx 0 0}.status{padding:50rpx 10rpx;text-align:center;color:#90998b;font-size:25rpx}button{background:#254b39;color:white;font-size:26rpx;border-radius:16rpx}.detail-art{height:440rpx;background:#e8ede0;border-radius:30rpx;margin:24rpx 0}.detail-art image,.detail-art private-image{height:100%;width:100%}.detail-name{font-size:48rpx;font-weight:700}.section{background:#fffefa;padding:28rpx;border-radius:24rpx;margin:24rpx 0;border:1rpx solid #e5e6dd}.section-title{font-size:30rpx;font-weight:600;margin-bottom:20rpx}.facts{display:grid;grid-template-columns:1fr 1fr;gap:28rpx}.fact-label{font-size:22rpx;color:#8a9387}.fact-value{font-size:27rpx;margin-top:10rpx}.form{display:inline-block;padding:15rpx 20rpx;background:#eef0e7;border-radius:14rpx;margin:0 12rpx 16rpx 0;font-size:24rpx}.selected{background:#284e3b;color:white}.relation{padding:20rpx 0;border-bottom:1rpx solid #e9ece2;font-size:26rpx}.source{word-break:break-all;font-size:20rpx;color:#929b8e;line-height:1.8}.car-placeholder{width:180rpx;height:70rpx;background:#8aa88a;border-radius:45rpx 65rpx 18rpx 18rpx;position:relative}.car-placeholder:before,.car-placeholder:after{content:"";width:38rpx;height:38rpx;border-radius:50%;background:#34483b;border:7rpx solid #fffefa;position:absolute;bottom:-20rpx}.car-placeholder:before{left:18rpx}.car-placeholder:after{right:18rpx}

.art-label{position:absolute;bottom:10rpx;right:12rpx;font-size:14rpx;color:#a4ad95;letter-spacing:1rpx}
.tomica-card{padding:0 22rpx 22rpx}.tomica-card .art{width:calc(100% + 44rpx);margin-left:-22rpx;border-radius:0;background:transparent}

/* Rounded collection themes, sharing the existing native page components. */
page{background:#f6f8fc;color:#293d56}.eyebrow,.muted{color:#8799ae}.heading{font-size:52rpx}.hero{border-radius:38rpx;background:linear-gradient(115deg,#ef7358,#ffba77);position:relative;overflow:hidden;box-shadow:0 14rpx 35rpx #cf754818}.hero-title{color:white;position:relative;z-index:1}.hero .muted{color:#fff5ea;position:relative;z-index:1}.hero:after{content:"";position:absolute;width:380rpx;height:250rpx;border:26rpx dashed #ffffff25;border-radius:120rpx;right:-160rpx;top:-55rpx;transform:rotate(-20deg)}
.pokemon-page .hero{background:linear-gradient(115deg,#4f83e7,#57c3b3);box-shadow:0 14rpx 35rpx #4c9dc418}.pokemon-page .hero:after{border-style:solid;border-width:4rpx;width:290rpx;height:290rpx;border-radius:50%;right:-60rpx;top:-80rpx}.search{background:white;border-color:#e4ebf4;border-radius:26rpx}.filters{flex-wrap:wrap}.picker{border-radius:22rpx;border-color:#e4ebf4;background:white;color:#6380a1}.card{border-radius:30rpx;border-color:#e5edf6;background:white;box-shadow:0 8rpx 22rpx #324e7508}.art{background:#eef5fc;border-radius:22rpx}.name{color:#304761}.number,.subtitle{color:#91a2b7}.chip{background:#e7f2fd;color:#6895bd;border-radius:12rpx}.tomica-page .chip{background:#fff0e5;color:#c5946d}.section{border-radius:30rpx;border-color:#e3ebf5;background:white}.detail-art{background:#edf4fc;border-radius:34rpx}.selected,button{background:#4c88cb}.status{color:#8d9db2}

.account-actions{display:flex;align-items:center;gap:18rpx;margin-top:18rpx;color:#7990a6;font-size:22rpx}.account-actions button{padding:0 4rpx;margin:0;background:transparent;color:#7990a6;line-height:1.6;font-size:22rpx}.account-actions button:after{border:0}
