.gp-page{padding:28rpx;background:#f3f6fc;color:#344662;min-height:100vh}.gp-hero{padding:35rpx;border-radius:32rpx;background:linear-gradient(120deg,#e9efff,#eee8fa,#e4f4f5);margin-bottom:18rpx}.gp-kicker{display:block;color:#9aa9c1;font-size:17rpx;letter-spacing:2rpx}.gp-title{display:block;font-size:39rpx;font-weight:600;line-height:1.7;margin:17rpx 0}.gp-note{display:block;color:#9aa8bd;font-size:21rpx;line-height:1.8}.gp-account{display:flex;justify-content:flex-end;gap:22rpx;font-size:19rpx;color:#9aa8bd;margin:15rpx 0}.gp-controls{background:#fff;border:1rpx solid #e6ebf5;padding:25rpx;border-radius:30rpx}.gp-modes{display:flex;padding:7rpx;background:#f1f4fb;border-radius:20rpx;margin-bottom:23rpx}.gp-modes view{flex:1;text-align:center;padding:18rpx 10rpx;font-size:25rpx;color:#a1adc3;border-radius:16rpx}.gp-modes .active{background:#fff;color:#687fc0}.gp-picker{font-size:23rpx;color:#8393b4;padding:18rpx 12rpx;border:1rpx solid #e8edf6;border-radius:15rpx}.gp-sales{display:flex;gap:9rpx;margin:20rpx 0}.gp-sale{flex:1;text-align:center;font-size:18rpx;white-space:nowrap;border:1rpx solid transparent;border-radius:15rpx;padding:16rpx 4rpx;color:#8297c3;background:#f0f4ff}.gp-sale.sale-2{color:#a18dbe;background:#f4eefb}.gp-sale.sale-3{color:#6fa799;background:#edf7f4}.gp-sale.sale-4{color:#bc9772;background:#fff4e8}.gp-sale.selected{border-color:currentColor}.gp-search{border:1rpx solid #e5ebf6;background:#fbfcff;border-radius:17rpx;padding:21rpx 20rpx;font-size:23rpx;margin:22rpx 0 15rpx}.gp-filterline{display:flex;gap:12rpx;align-items:center}.gp-filterline picker{flex:1}.gp-filterline text{font-size:22rpx;color:#98a7c1;padding:15rpx}.gp-heading{display:flex;align-items:center;justify-content:space-between;margin:33rpx 0 23rpx;font-size:32rpx}.gp-heading text+text{font-size:21rpx;color:#9eacc1}.gp-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx}.gp-card{min-width:0;background:#fff;border:1rpx solid #e1e8f4;border-radius:26rpx;overflow:hidden}.gp-photo{width:100%;height:275rpx;display:block;background:#edf1f8}.gp-copy{padding:23rpx 20rpx}.gp-name{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:24rpx;line-height:1.7;min-height:79rpx;margin:13rpx 0}.gp-copy .gp-note{font-size:18rpx}.gp-pagination{display:flex;align-items:center;justify-content:center;gap:25rpx;margin:28rpx 0;font-size:22rpx;color:#93a4be}.gp-pagination button{margin:0;border-radius:15rpx;font-size:22rpx;color:#8799bd;background:white}.gp-aside{background:#ffffffd9;border:1rpx solid #e4eaf5;border-radius:28rpx;padding:25rpx;margin-top:25rpx}.gp-section-title{font-size:29rpx;display:block;margin-bottom:23rpx}.gp-events{white-space:nowrap}.gp-event{display:inline-block;vertical-align:top;width:270rpx;margin-right:22rpx;white-space:normal}.gp-event-image{display:block;width:270rpx;height:165rpx;border-radius:17rpx;overflow:hidden}.gp-event-name{font-size:22rpx;line-height:1.8;display:block;margin:15rpx 0 10rpx}.gp-event .gp-note{font-size:17rpx}.gp-month{display:block;color:#8b9ec3;font-size:24rpx;margin:24rpx 0 20rpx}.gp-release{display:flex;align-items:center;gap:20rpx;margin-bottom:20rpx}.gp-release-image{display:block;width:100rpx;height:105rpx;border-radius:15rpx;overflow:hidden;flex-shrink:0}.gp-release-name{display:block;font-size:23rpx;line-height:1.7}.gp-error{color:#b98d85;font-size:23rpx;padding:30rpx}.gp-loading{text-align:center;padding:25rpx}
