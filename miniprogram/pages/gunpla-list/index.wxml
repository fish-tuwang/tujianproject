<view class="gp-page"><view class="gp-hero"><text class="gp-kicker">BUILD YOUR OWN UNIVERSE</text><text class="gp-title">下一台心动，从这里拼起。</text><text class="gp-note">穿过规格与作品，找到属于你的那台机体。</text></view><view class="gp-account"><text>{{authUsername}}</text><text bindtap="changePassword">修改密码</text><text bindtap="logout">退出</text></view><view class="gp-controls"><view class="gp-modes"><view class="{{query.mode==='grade'?'active':''}}" data-mode="grade" bindtap="mode">按规格探索</view><view class="{{query.mode==='series'?'active':''}}" data-mode="series" bindtap="mode">按作品探索</view></view><view wx:if="{{query.mode==='grade'}}"><picker range="{{brands}}" value="{{gradeIndex}}" bindchange="grade"><view class="gp-picker">模型规格 · {{brands[gradeIndex]}} ▾</view></picker><view class="gp-sales"><view wx:for="{{sales}}" wx:key="id" class="gp-sale sale-{{item.id}} {{query.sale_type===item.id?'selected':''}}" data-sale="{{item.id}}" bindtap="sale">{{item.name}}</view></view></view><view wx:else><picker mode="multiSelector" range="{{seriesColumns}}" value="{{seriesSelection}}" bindcolumnchange="seriesColumn" bindchange="series"><view class="gp-picker">按年代选择作品 · {{seriesName}} ▾</view></picker><text class="gp-note">同一作品的普通与各类限定统一展示。</text></view><input class="gp-search" placeholder="搜索模型名称、规格或机体编号" value="{{query.q}}" bindinput="search"/><view class="gp-filterline"><picker range="{{scales}}" value="{{scaleIndex}}" bindchange="scale"><view class="gp-picker">{{scales[scaleIndex]}} ▾</view></picker><picker range="{{sizes}}" value="{{sizeIndex}}" bindchange="size"><view class="gp-picker">每页 {{query.limit}} 款 ▾</view></picker><text bindtap="reset">重置</text></view></view><view class="gp-heading"><text>探索高达模型</text><text>{{total}} 款模型</text></view><view class="gp-grid"><view wx:for="{{items}}" wx:key="id" class="gp-card" data-id="{{item.id}}" bindtap="open"><private-image class="gp-photo" src="{{item.image_url}}" mode="aspectFill"/><view class="gp-copy"><text class="gp-kicker">{{item.scale||'GUNPLA'}}</text><text class="gp-name">{{item.name}}</text><text class="gp-note">{{item.release_text||'发售时间未公布'}}</text></view></view></view><view wx:if="{{error}}" class="gp-error" bindtap="load">{{error}} · 点击重试</view><view wx:if="{{loading}}" class="gp-note gp-loading">正在翻阅模型档案…</view><view wx:if="{{!loading&&!items.length}}" class="gp-loading gp-note">暂无符合条件的模型</view><view class="gp-pagination"><button size="mini" disabled="{{query.page<=1||loading}}" data-delta="-1" bindtap="page">上一页</button><text>{{query.page}} / {{totalPages}}</text><button size="mini" disabled="{{query.page>=totalPages||loading}}" data-delta="1" bindtap="page">下一页</button></view><view class="gp-aside"><text class="gp-section-title">活动预览</text><scroll-view scroll-x class="gp-events"><view wx:for="{{home.events}}" wx:key="id" class="gp-event" data-url="{{item.image_url}}" bindtap="previewEvent"><private-image src="{{item.image_url}}" class="gp-event-image" mode="aspectFill"/><text class="gp-event-name">{{item.name}}</text><text class="gp-note">{{item.channel}} · {{item.status_text}}</text><text class="gp-note">{{item.date_text}}</text></view></scroll-view></view><view class="gp-aside"><text class="gp-section-title">发售预告</text><view wx:for="{{home.upcoming}}" wx:key="month"><text class="gp-month">{{item.month}}</text><view wx:for="{{item.items}}" wx:for-item="model" wx:key="id" class="gp-release" data-id="{{model.id}}" bindtap="open"><private-image class="gp-release-image" src="{{model.image_url}}" mode="aspectFill"/><view><text class="gp-release-name">{{model.name}}</text><text class="gp-note">{{model.release_text}}</text></view></view></view></view></view>
