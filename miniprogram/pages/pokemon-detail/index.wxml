<import src="extra.wxml"/>
<view class="page"><view wx:if="{{loading}}" class="status">正在打开图鉴…</view><view wx:elif="{{error}}" class="status">{{error}}<button bindtap="retry">重试</button></view><block wx:elif="{{detail}}"><view class="eyebrow">{{detail.numberLabel}} / LITTLE ATLAS</view><view class="detail-art art"><image wx:if="{{detail.image_url}}" src="{{detail.image_url}}" mode="aspectFit" binderror="imageError"/><text wx:else class="muted">暂无原图</text></view><view class="detail-name">{{detail.title}}</view><view class="muted" style="margin-top:12rpx">{{detail.name_en || detail.name_original}}</view><view class="section"><view class="section-title">基础档案</view><view class="facts"><block wx:if="{{kind === 'tomica'}}"><view><view class="fact-label">汽车品牌</view><view class="fact-value">{{detail.brand || '暂无资料'}}</view></view><view><view class="fact-label">基础车型发售年份</view><view class="fact-value">{{detail.release_year || '未知'}}</view></view><view><view class="fact-label">比例</view><view class="fact-value">{{detail.scale || '暂无资料'}}</view></view><view><view class="fact-label">系列</view><view class="fact-value">{{detail.series}}</view></view></block><block wx:else><view><view class="fact-label">身高</view><view class="fact-value">{{detail.height_m === null ? '暂无资料' : detail.height_m + ' m'}}</view></view><view><view class="fact-label">体重</view><view class="fact-value">{{detail.weight_kg === null ? '暂无资料' : detail.weight_kg + ' kg'}}</view></view><view><view class="fact-label">日文名</view><view class="fact-value">{{detail.name_ja || '暂无资料'}}</view></view><view><view class="fact-label">特性</view><text class="fact-value" wx:for="{{detail.abilities}}" wx:key="*this">{{item}} </text></view></block></view></view><view wx:if="{{kind === 'tomica'}}" class="section"><view class="section-title">版本记录</view><view class="relation" wx:for="{{detail.variants}}" wx:key="id"><image wx:if="{{item.image_url}}" src="{{item.image_url}}" mode="aspectFit" style="width:220rpx;height:160rpx"/><view>{{item.variant_code || '版本编号待整理'}}</view><view class="muted">{{item.description || '暂无说明'}}</view><view class="muted">{{item.country || '产地未知'}} · {{item.release_year || '版本发售年份未知'}}</view></view></view><block wx:else><view class="section"><view class="section-title">形态与属性</view><view wx:for="{{detail.forms}}" wx:key="id" class="form {{activeForm === index ? 'selected' : ''}}" bindtap="chooseForm" data-index="{{index}}">{{item.display_name}}</view><view><text wx:for="{{selectedForm.types || detail.types}}" wx:key="*this" class="chip">{{item}}</text></view></view><view class="section"><view class="section-title">进化关系</view><view wx:if="{{!detail.evolutions.length}}" class="muted">暂无进化资料</view><view class="relation" wx:for="{{detail.evolutions}}" wx:key="id"><text bindtap="evolve" data-dex="{{item.from_dex}}" data-available="{{item.from_available}}">{{item.from_name || item.from_dex}}</text> → <text bindtap="evolve" data-dex="{{item.to_dex}}" data-available="{{item.to_available}}">{{item.to_name || item.to_dex}}</text><view class="muted">{{item.condition || '条件待整理'}}</view></view></view></block><template is="pokemon-extra" data="{{extras: extras}}"/><view class="source">资料来源：{{detail.source_url}}<view>最近更新：{{detail.updated_at}}</view></view></block></view>