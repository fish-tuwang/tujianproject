/* 页面使用 app.wxss 共享视觉样式。 */
.extra-picker{padding:18rpx;background:#eef1e7;border-radius:10rpx;font-size:23rpx;margin-bottom:18rpx}.stat-total{font-size:32rpx;color:#547345;margin:15rpx 0}.stat-row{display:flex;align-items:center;gap:18rpx;margin:18rpx 0;font-size:23rpx}.stat-row>text:first-child{width:70rpx}.stat-row>text{width:45rpx}.stat-track{flex:1;height:18rpx;background:#f0f0e6;border-radius:6rpx;overflow:hidden}.stat-fill{height:100%;background:#93ae75}.extra-scroll{height:560rpx}.move-row{padding:20rpx 0;border-bottom:1rpx solid #e6e9dc;font-size:25rpx;line-height:1.8}.extra-search{padding:18rpx;border:1rpx solid #dce3d2;border-radius:10rpx;font-size:23rpx;margin:15rpx 0}.matchup-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:20rpx}.matchup-cell{text-align:center;background:#edf1e5;border-radius:12rpx;padding:18rpx;line-height:1.8;font-size:24rpx}.shiny-pair{display:flex;gap:18rpx;text-align:center;font-size:24rpx}.shiny-pair>view{flex:1;background:#eef1e5;border-radius:18rpx;padding:12rpx 4rpx 25rpx}.shiny-pair>view+view{background:#f5eedf}.shiny-pair image{width:100%;height:260rpx}
