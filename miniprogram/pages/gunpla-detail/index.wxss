.gp-detail{padding:30rpx;background:#f4f7fc;color:#3b4e6c;min-height:100vh}.gp-kicker{display:block;font-size:17rpx;letter-spacing:2rpx;color:#a0acc2}.gp-detail-title{display:block;font-size:35rpx;line-height:1.7;margin:22rpx 0 25rpx}.gp-main-image{width:100%;height:620rpx;display:block;background:#fff;border-radius:27rpx;overflow:hidden}.gp-thumbnails{white-space:nowrap;padding:20rpx 0}.gp-thumbnail{width:130rpx;height:120rpx;border:3rpx solid transparent;background:#fff;border-radius:16rpx;overflow:hidden;display:inline-block;margin-right:14rpx}.gp-thumbnail.selected{border-color:#94a8df}.gp-thumbnail private-image{display:block;width:100%;height:100%}.gp-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13rpx;margin:17rpx 0 33rpx}.gp-facts view{min-width:0;background:#eaf0fb;border-radius:19rpx;padding:24rpx 17rpx}.gp-facts view:nth-child(2){background:#f1eafb}.gp-facts view:nth-child(3){background:#e9f5f1}.gp-facts text{display:block;font-size:18rpx;color:#9aa8c0;line-height:1.7}.gp-facts .gp-value{font-size:25rpx;color:#7188af;margin-top:14rpx;overflow-wrap:anywhere}.gp-photo-title{font-size:27rpx;display:block;margin:30rpx 0 24rpx;color:#8a9cbb}.gp-photo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.gp-detail-image{width:100%;height:330rpx;border-radius:20rpx;overflow:hidden;background:#fff;display:block}.gp-message{font-size:25rpx;color:#9eabc1;text-align:center;padding:45rpx}
