<view class="gp-detail"><view wx:if="{{loading}}" class="gp-message">正在展开模型详情…</view><view wx:if="{{error}}" class="gp-message" bindtap="load">{{error}} · 点击重试</view><block wx:if="{{detail}}"><text class="gp-kicker">GUNPLA MODEL ARCHIVE</text><text class="gp-detail-title">{{detail.name}}</text><private-image src="{{activeImage}}" class="gp-main-image" mode="aspectFit" data-url="{{activeImage}}" bindtap="previewImage"/><scroll-view scroll-x class="gp-thumbnails"><view wx:for="{{detail.gallery}}" wx:key="*this" class="gp-thumbnail {{activeImage===item?'selected':''}}" data-url="{{item}}" bindtap="chooseImage"><private-image src="{{item}}" mode="aspectFit"/></view></scroll-view><view class="gp-facts"><view><text>官方价格 · 人民币</text><text class="gp-value">{{detail.price_cny_text||'未公布'}}</text></view><view><text>日本建议零售价</text><text class="gp-value">{{detail.price_jpy_text||'未公布'}}</text></view><view><text>发售日期</text><text class="gp-value">{{detail.release_text||'未公布'}}</text></view></view><text class="gp-photo-title">商品图与细节</text><view class="gp-photo-grid"><private-image wx:for="{{detail.gallery}}" wx:key="*this" class="gp-detail-image" src="{{item}}" mode="aspectFit" data-url="{{item}}" bindtap="previewImage"/><private-image wx:for="{{detail.detail_images}}" wx:key="*this" class="gp-detail-image" src="{{item}}" mode="aspectFit" data-url="{{item}}" bindtap="previewImage"/></view></block></view>
