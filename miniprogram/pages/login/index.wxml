<view class="page login-page"><view class="eyebrow">LITTLE ATLAS / 小小藏家</view><view class="hero"><view class="hero-title">把热爱，一件件收好。</view></view><view class="login-card"><view class="heading">{{passwordMode ? '设置新的密码' : '欢迎回来'}}</view><view class="muted">{{passwordMode ? '首次登录或修改密码，请设置15–128个字符的新密码。' : '登录后，继续你的图鉴旅程。'}}</view><block wx:if="{{!passwordMode}}"><input class="search" placeholder="账号" value="{{username}}" data-key="username" bindinput="input" maxlength="64"/><input class="search" placeholder="密码" value="{{password}}" data-key="password" bindinput="input" password maxlength="128"/></block><block wx:else><view class="muted">{{username}}</view><input class="search" placeholder="当前密码" value="{{currentPassword}}" data-key="currentPassword" bindinput="input" password maxlength="128"/><input class="search" placeholder="新密码（15–128个字符）" value="{{newPassword}}" data-key="newPassword" bindinput="input" password maxlength="128"/><input class="search" placeholder="确认新密码" value="{{confirmation}}" data-key="confirmation" bindinput="input" password maxlength="128"/></block><view class="login-error" role="status">{{error}}</view><button loading="{{loading}}" disabled="{{loading}}" bindtap="submit">{{passwordMode ? '保存并进入图鉴' : '登录，翻开图鉴'}}</button><button wx:if="{{passwordMode}}" class="logout-button" bindtap="logout">退出登录</button><view class="login-footer">仅限已开通的账号登录</view></view></view>
