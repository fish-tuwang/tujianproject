<view class="page {{kind}}-page"><view class="eyebrow">LITTLE ATLAS / 小小藏家</view><view class="heading">{{kind === 'tomica' ? '把热爱，一件件收好。' : '每一次相遇，都有迹可循。'}}</view><view class="muted">{{kind === 'tomica' ? '发现小车里的大世界' : '从 #0001 出发，探索宝可梦世界'}}</view><view wx:if="{{authUsername}}" class="account-actions"><text>{{authUsername}}</text><button bindtap="changePassword">修改密码</button><button bindtap="logout" disabled="{{logoutPending}}">退出</button></view><view class="hero"><view class="hero-title">{{kind === 'tomica' ? '属于你的车库时光' : '开启你的图鉴旅程'}}</view><view class="muted" style="margin-top:12rpx">{{kind === 'tomica' ? '按品牌与基础车型发售年份探索' : '按 Wiki 全国编号分段归类'}}</view></view><input class="search" placeholder="{{kind === 'tomica' ? '搜索车型、品牌或编号' : '搜索名称或全国编号'}}" bindinput="search"/><view class="filters"><block wx:if="{{kind === 'tomica'}}"><picker range="{{brands}}" value="{{brandIndex}}" bindchange="filterBrand"><view class="picker">{{brands[brandIndex]}} ▾</view></picker><picker range="{{years}}" value="{{yearIndex}}" bindchange="filterYear"><view class="picker">{{years[yearIndex]}} ▾</view></picker></block><block wx:else><picker range="{{regions}}" value="{{regionIndex}}" bindchange="filterRegion"><view class="picker">{{regions[regionIndex]}} ▾</view></picker><picker range="{{types}}" value="{{typeIndex}}" bindchange="filterType"><view class="picker">{{types[typeIndex]}} ▾</view></picker></block></view><view class="grid"><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{kind === 'pokemon' ? item.dex : item.id}}" bindtap="open"><view class="art"><private-image wx:if="{{item.image_url}}" src="{{item.image_url}}" mode="aspectFit" binderror="imageError" data-index="{{index}}"/><text wx:else class="muted">暂无原图</text></view><view class="number">{{item.numberLabel}}</view><view class="name">{{item.title}}</view><view class="subtitle">{{item.subtitle}}</view><view wx:if="{{kind === 'tomica'}}" class="chip">{{item.yearLabel}}</view><text wx:else wx:for="{{item.types}}" wx:for-item="type" wx:key="*this" class="chip">{{type}}</text></view></view><view wx:if="{{loading}}" class="status">正在翻阅图鉴…</view><view wx:elif="{{error}}" class="status">{{error}}<button bindtap="retry">重新加载</button></view><view wx:elif="{{!items.length}}" class="status">没有找到对应条目，试试其他筛选条件</view><view wx:elif="{{!hasMore}}" class="status">本次结果已全部呈现</view></view>