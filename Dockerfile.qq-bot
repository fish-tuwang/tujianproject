FROM dual-catalog:0.11.4
COPY backend/app/qq_bot.py backend/app/qq_catalog.py /app/backend/app/
LABEL org.opencontainers.image.title="图鉴QQ查询桥接" org.opencontainers.image.version="0.1.1"
USER 10001:10001
CMD ["python", "-m", "uvicorn", "backend.app.qq_bot:application", "--factory", "--host", "127.0.0.1", "--port", "8096", "--no-access-log", "--no-proxy-headers"]
